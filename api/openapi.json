{
  "components": {
    "parameters": {
      "Action": {
        "in": "path",
        "name": "action",
        "required": true,
        "schema": {
          "enum": [
            "activate",
            "pause",
            "resume",
            "stop",
            "segments"
          ],
          "type": "string"
        }
      },
      "ArtifactId": {
        "in": "path",
        "name": "artifact_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ArtifactName": {
        "in": "path",
        "name": "artifact_name",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "Channel": {
        "in": "path",
        "name": "channel",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "DeviceId": {
        "description": "Registered active device identity; a Phone may bridge-read a Watch-targeted artifact.",
        "in": "query",
        "name": "device_id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "DevicePath": {
        "in": "path",
        "name": "device_id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "EventId": {
        "in": "path",
        "name": "event_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "Generation": {
        "in": "path",
        "name": "generation",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "PartId": {
        "in": "path",
        "name": "part_id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "ProjectId": {
        "in": "path",
        "name": "project_id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "ScheduleId": {
        "in": "path",
        "name": "schedule_id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "SegmentSequence": {
        "in": "path",
        "name": "segment_sequence",
        "required": true,
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "Sequence": {
        "in": "path",
        "name": "sequence",
        "required": true,
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "SessionId": {
        "in": "path",
        "name": "session_id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "TurnId": {
        "in": "path",
        "name": "turn_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "UserId": {
        "description": "Owner identity paired with the registered active device.",
        "in": "query",
        "name": "user_id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "schemas": {
      "ArtifactState": {
        "enum": [
          "PENDING",
          "READY",
          "DELIVERY_PENDING",
          "PLAYED",
          "FAILED_GENERATION",
          "EXPIRED"
        ],
        "type": "string"
      },
      "DeviceRevoke": {
        "additionalProperties": false,
        "properties": {
          "actor_device_id": {
            "minLength": 1,
            "type": "string"
          },
          "user_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "actor_device_id"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "EventAck": {
        "properties": {
          "device_id": {
            "minLength": 1,
            "type": "string"
          },
          "event_version": {
            "minimum": 1,
            "type": "integer"
          },
          "payload_sha256": {
            "minLength": 1,
            "type": "string"
          },
          "user_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "device_id",
          "event_version",
          "payload_sha256"
        ],
        "type": "object"
      },
      "EventKind": {
        "enum": [
          "ACCEPTED",
          "ROUTED",
          "FINAL"
        ],
        "type": "string"
      },
      "FinishPart": {
        "properties": {
          "duration_ms": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "total_bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "total_chunks": {
            "minimum": 1,
            "type": "integer"
          },
          "whole_stream_sha256": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "total_chunks",
          "total_bytes",
          "whole_stream_sha256"
        ],
        "type": "object"
      },
      "OwnerProof": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "minLength": 1,
            "type": "string"
          },
          "user_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "device_id"
        ],
        "type": "object"
      },
      "PlaybackAck": {
        "additionalProperties": false,
        "properties": {
          "artifact_version": {
            "minimum": 1,
            "type": "integer"
          },
          "device_id": {
            "minLength": 1,
            "type": "string"
          },
          "payload_sha256": {
            "minLength": 1,
            "type": "string"
          },
          "turn_id": {
            "format": "uuid",
            "minLength": 1,
            "type": "string"
          },
          "user_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "device_id",
          "payload_sha256",
          "turn_id",
          "artifact_version"
        ],
        "type": "object"
      },
      "RelayReceived": {
        "properties": {
          "device_id": {
            "minLength": 1,
            "type": "string"
          },
          "payload_sha256": {
            "minLength": 1,
            "type": "string"
          },
          "user_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "device_id",
          "payload_sha256"
        ],
        "type": "object"
      },
      "ScheduleState": {
        "enum": [
          "SCHEDULED",
          "CLAIMED",
          "FIRED",
          "FAILED",
          "CANCELLED"
        ],
        "type": "string"
      },
      "ServerTurnSource": {
        "enum": [
          "server_schedule"
        ],
        "type": "string"
      },
      "TurnCreate": {
        "properties": {
          "origin_device_id": {
            "minLength": 1,
            "type": "string"
          },
          "parts": {
            "minItems": 1,
            "type": "array"
          },
          "turn_id": {
            "format": "uuid",
            "type": "string"
          },
          "user_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "turn_id",
          "origin_device_id",
          "parts"
        ],
        "type": "object"
      },
      "TurnState": {
        "enum": [
          "RECEIVING",
          "ACCEPTED",
          "PREPROCESSING",
          "ROUTING",
          "ROUTED",
          "HERMES_PENDING",
          "FINAL_READY",
          "DELIVERY_PENDING",
          "RETRY_WAIT",
          "LATE_RESULT_GRACE",
          "DELIVERED",
          "FAILED_PERMANENT",
          "EXPIRED"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "RecorderPrincipal": {
        "description": "HMAC-SHA256 proof over X-Recorder-Principal-User, a NUL byte, and X-Recorder-Principal-Device. The deployment secret stays outside the API payload and logs.",
        "in": "header",
        "name": "X-Recorder-Principal-Signature",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Standalone reliable Recorder adapter; Hermes core and legacy port 5000 are out of scope.",
    "title": "Recorder Next Server",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/devices": {
      "post": {
        "responses": {
          "201": {
            "description": "Registered device"
          }
        },
        "security": [
          {
            "RecorderPrincipal": []
          }
        ]
      }
    },
    "/v1/devices/{device_id}/revoke": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DevicePath"
        }
      ],
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRevoke"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Revoked device"
          }
        },
        "security": [
          {
            "RecorderPrincipal": []
          }
        ]
      }
    },
    "/v1/diagnostics": {
      "delete": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
