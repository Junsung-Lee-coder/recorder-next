          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Target playback completion"
          },
          "400": {
            "description": "Required receipt field missing or invalid"
          },
          "401": {
            "description": "Only the delivery target may complete playback"
          },
          "409": {
            "description": "Receipt does not match the stored artifact"
          }
        },
        "security": [
          {
            "RecorderPrincipal": []
          }
        ],
        "summary": "Complete playback on the actual TTS delivery target"
      }
